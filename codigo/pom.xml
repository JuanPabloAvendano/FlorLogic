<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- TEC-02 · Spring Boot 4.1.x. 4.1.2 (22-oct-2026) desde el 31-oct: Trivy halló en la 4.1.1 cuatro CRITICAL de
       Tomcat 11.0.24 (CVE-2026-65182, -65637, -65905, -68525) y cinco HIGH de Jackson 3.1.5; la 4.1.2 trae Tomcat
       11.0.27 y Jackson 3.1.7, sin avisos en OSV (solo cambia el parche: §4 paso 4 de IA_TECNOLOGIAS-vigentes) -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>co.florlogic</groupId>
  <artifactId>florlogic</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FlorLogic</name>

  <!-- TEC-03 · Maven multi-módulo (IA_TECNOLOGIAS-y-estructura.md §2) -->
  <modules>
    <module>contrato</module>
    <module>backend-finca</module>
    <module>servicios-en-linea</module>
    <module>simulador</module>
    <module>pruebas-extremo-a-extremo</module>
  </modules>

  <properties>
    <!-- TEC-01 decía Java 21 LTS; Juan pasó a Java 27 el 14-oct-2026 (TEC-01 por actualizar) -->
    <java.version>27</java.version>
    <maven.compiler.release>27</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Construcción reproducible: fecha fija en los artefactos -->
    <project.build.outputTimestamp>2026-10-13T00:00:00Z</project.build.outputTimestamp>

    <spring-modulith.version>2.1.1</spring-modulith.version>
    <!-- Java 27: Modulith 2.1.1 trae ArchUnit 1.4.2, que no lee clases versión 71 -->
    <archunit.version>1.5.1</archunit.version>
    <picocli.version>4.7.7</picocli.version>
    <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
    <!-- TEC-34 · tren 2025.1.4 (Spring Cloud Vault 5.0.3): es para Boot 4.0; excepción anotada con Boot 4.1.1 hasta
         que 2026.0.0 sea estable. NodoCompletoTest es la prueba de que funciona (ESPEC-esqueleto-tx1 A-43) -->
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <!-- TEC-38 · JaCoCo 0.8.16: la primera que instrumenta clases de Java 27 (versión 71); la 0.8.14 no las lee -->
    <jacoco.version>0.8.16</jacoco.version>
    <!-- TEC-39 · análisis estático con SonarQube Community Build (perfil «calidad» de despliegue/compose.yaml) -->
    <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
    <sonar.projectKey>florlogic</sonar.projectKey>
    <sonar.projectName>FlorLogic</sonar.projectName>
    <sonar.host.url>http://localhost:9000</sonar.host.url>
    <!-- Cada módulo deja su informe de JaCoCo en target/site/jacoco/; Sonar lo lee de ahí -->
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>co.florlogic</groupId>
        <artifactId>contrato</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- TEC-05 · Spring Modulith -->
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- TEC-34 · Spring Cloud (solo Spring Cloud Vault) -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <!-- TEC-25 · simulador -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- TEC-38 · cobertura: el agente se engancha a las pruebas y el informe sale en verify
             (target/site/jacoco/index.html y jacoco.xml, el que lee Sonar) -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>agente-de-cobertura</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>informe-de-cobertura</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <!-- TEC-39 · «./mvnw sonar:sonar» contra el SonarQube de sonar.host.url; el token llega por SONAR_TOKEN -->
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

<!--
  ── Guía de lectura · IA (Claude), 3-nov-2026, a pedido de Juan · SIN REVISAR ──
  Propósito: el pom padre de FlorLogic. No produce un programa (packaging pom): reúne los cinco módulos, fija la
  versión de Java, las versiones de las bibliotecas y los complementos que comparten todos.
  Uso: lo lee Maven en cada «./mvnw verify» desde codigo/. Construye los módulos en el orden de sus dependencias
  (contrato primero, porque backend-finca y simulador lo usan), no en el orden en que aparecen.
  Origen: las filas TEC de .claude/contexto/IA_TECNOLOGIAS-vigentes.md que cita cada comentario.
  Línea por línea (lo no obvio):
  - modelVersion 4.0.0: la versión del formato del pom; siempre es esa en Maven 3.
  - parent spring-boot-starter-parent 4.1.2 (TEC-02, Spring Boot): hereda de Spring Boot las versiones de cientos
    de bibliotecas (Jackson, JUnit, AssertJ, Testcontainers, el controlador de PostgreSQL…) y la configuración de
    los complementos de compilación y pruebas. Por eso los poms de los módulos casi nunca escriben versión.
  - relativePath vacío: el padre no se busca en una carpeta vecina sino en el repositorio de Maven.
  - groupId co.florlogic, artifactId florlogic, version 0.1.0-SNAPSHOT: el nombre de este proyecto. SNAPSHOT
    significa «versión en desarrollo», no publicada.
  - packaging pom: este archivo solo agrupa; no genera un .jar.
  - modules (TEC-03, Maven multimódulo): los cinco módulos que se construyen juntos.
  - java.version y maven.compiler.release 27 (TEC-01): Spring Boot lee la primera; el compilador lee la segunda y
    compila para Java 27, sin dejar usar API de otra versión del JDK.
  - project.build.sourceEncoding UTF-8: los fuentes se leen en UTF-8 (tildes y eñes del dominio).
  - project.build.outputTimestamp (TEC-03): fecha fija dentro de los .jar; así dos construcciones del mismo código
    dan los mismos bytes (construcción reproducible).
  - spring-modulith.version 2.1.1 (TEC-05): versión de Spring Modulith, la que verifica los módulos del backend.
  - archunit.version 1.5.1 (TEC-05): se fuerza porque la 1.4.2 que trae Modulith no lee clases de Java 27.
  - picocli.version y sqlite-jdbc.version (TEC-25): las bibliotecas del simulador.
  - spring-cloud.version 2025.1.4 (TEC-34): el tren de Spring Cloud de donde sale Spring Cloud Vault.
  - jacoco.version 0.8.16 (TEC-38): cobertura de pruebas.
  - sonar-maven-plugin.version, sonar.projectKey, sonar.projectName, sonar.host.url (TEC-39): con qué nombre y a
    qué servidor SonarQube manda el análisis «./mvnw sonar:sonar»; localhost:9000 es el del perfil calidad de
    despliegue/compose.yaml.
  - sonar.coverage.jacoco.xmlReportPaths: dónde busca Sonar el informe de JaCoCo de cada módulo; la expresión
    project.build.directory es la carpeta target del módulo que se analiza.
  - dependencyManagement: aquí no se agrega ninguna dependencia; solo se fija la versión de las que un módulo
    declare después sin versión.
    · co.florlogic:contrato con project.version: los módulos que usan el contrato toman siempre el de este mismo
      proyecto.
    · spring-modulith-bom y spring-cloud-dependencies con type pom y scope import: importan la lista de versiones
      de Spring Modulith (TEC-05) y de Spring Cloud (TEC-34), como si estuvieran escritas aquí.
    · archunit con archunit.version: el forzado de arriba; gana sobre la que trae Modulith.
    · picocli y sqlite-jdbc (TEC-25): versiones para el simulador.
  - pluginManagement: igual que dependencyManagement pero para complementos; fija versión y configuración, y solo
    se activan donde se declaran.
    · jacoco-maven-plugin (TEC-38): la ejecución agente-de-cobertura (meta prepare-agent) engancha el agente de
      JaCoCo a la JVM de las pruebas; la ejecución informe-de-cobertura (meta report, fase verify) escribe
      target/site/jacoco/index.html y jacoco.xml.
    · sonar-maven-plugin (TEC-39): solo fija la versión; se usa a mano con «./mvnw sonar:sonar». El token llega
      por la variable SONAR_TOKEN, nunca en este archivo.
  - build plugins jacoco-maven-plugin: aquí sí se activa, y por herencia corre en los cinco módulos.
-->
