or=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="550" width="300" height="50" as="geometry"/></mxCell><mxCell id="prop-34" value="AnotacionId · ConsecutivoValor · HuellaValor …" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="prop-33"><mxGeometry y="30" width="300" height="20" as="geometry"/></mxCell><mxCell id="prop-35" value="avance/  (sin cambio)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;collapsible=0;marginBottom=0;html=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="550" width="260" height="70" as="geometry"/></mxCell><mxCell id="prop-36" value="AvanceDelDispositivoAgregado" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="prop-35"><mxGeometry y="30" width="260" height="20" as="geometry"/></mxCell><mxCell id="prop-37" value="LlegadaAlAvance" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="prop-35"><mxGeometry y="50" width="260" height="20" as="geometry"/></mxCell><mxCell id="prop-38" value="Regla ArchUnit (1) se angosta:&#10;• controladores (sin ensamblador): solo puerto, dto, ensamblador, Spring web/http&#10;• controladores/ensamblador: además contrato y tools.jackson&#10;• fuera del ensamblador nadie ve contrato ni Jackson (A-103, A-105)&#10;Mutación: un import de contrato en el controlador → la regla falla.&#10;Comportamiento igual: CanalParticionesTest y CanalPorGatewayTest&#10;siguen en verde; pruebas unitarias del ensamblador (7)." style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;