fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="260" height="50" as="geometry"/></mxCell><mxCell id="contrato-6" value="⚠ hoy también importan contrato" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="contrato-5"><mxGeometry y="30" width="260" height="20" as="geometry"/></mxCell><mxCell id="contrato-7" value="contrato = lenguaje de la comunicación" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f6f0fa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="60" width="260" height="170" as="geometry"/></mxCell><mxCell id="contrato-8" value="ParticionDto · ResultadoParticionDto" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;collapsible=0;marginBottom=0;html=0;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="240" height="90" as="geometry"/></mxCell><mxCell id="contrato-9" value="LectorDto (lector estricto, A-9)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="contrato-8"><mxGeometry y="30" width="240" height="20" as="geometry"/></mxCell><mxCell id="contrato-10" value="CodigoIngreso · cabeceras" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="contrato-8"><mxGeometry y="50" width="240" height="20" as="geometry"/></mxCell><mxCell id="contrato-11" value="pruebas doradas del contrato" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="contrato-8"><mxGeometry y="70" width="240" height="20" as="geometry"/></mxCell><mxCell id="contrato-12" value="backend-finca" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="20" width="360" height="260" as="geometry"/></mxCell><mxCell id="contrato-13" value="ParticionEnsamblador" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;collapsible=0;marginBottom=0;html=0;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="320" height="70" as="geometry"/></mxCell><mxCell id="contrato-14" value="infraestructura/input/controladores/ensamblador" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="contrato-13"><mxGeometry y="30" width="320" height="20" as="geometry"/></mxCell><mxCell id="contrato-15" value="JSON → ParticionDto → SolicitudDto" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="contrato-13"><mxGeometry y="50" width="320" height="20" as="geometry"/></mxCell><mxCell id="contrato-16" value="servicios y dominio" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;collapsible=0;marginBottom=0;html=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="320" height="50" as="geometry"/></mxCell><mxCell id="contrato-17" value="no ven contrato (CapasTest)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="contrato-16"><mxGeometry y="30" width="320" height="20" as="geometry"/></mxCell><mxCell id="contrato-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="contrato-2" target="contrato-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="contrato-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="contrato-13" target="contrato-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="contrato-20" value="⚠ hacia afuera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="contrato-5" target="contrato-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="contrato-21" value="HTTP + JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="contrato-2" target="contrato-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="contrato-22" value="Sin el módulo: el simulador y el backend escriben cada uno sus DTO del cable&#10;y pueden desviarse sin que nada falle hasta producción.&#10;Con él: una sola definición, probada una vez, leída solo por adaptadores&#10;(anillo de afuera de Clean Architecture; en DDD, «lenguaje publicado»).&#10;Lo que sí está mal: el simulador lo deja entrar a servicios (⚠)." style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="600" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
