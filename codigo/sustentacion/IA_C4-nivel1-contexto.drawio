<mxfile host="drawio"><diagram name="C4 N1 · Contexto" id="n1"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1-1" value="C4 · Nivel 1 · Contexto del sistema FlorLogic (vista de TX-1, con lo que toca TX-2)" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="n1-2" value="Operador de campo&#10;[Persona]&#10;Captura en la cama sin red&#10;y sincroniza al volver" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;arcSize=30;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="210" height="90" as="geometry"/></mxCell><mxCell id="n1-3" value="Gerente de finca&#10;[Persona]&#10;Ve esperado, recibido y&#10;lo que falta; corrige" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;arcSize=30;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="210" height="90" as="geometry"/></mxCell><mxCell id="n1-4" value="Administrador de la finca&#10;[Persona]&#10;Usuarios, dispositivos y&#10;parámetros; recibe avisos" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;arcSize=30;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="210" height="90" as="geometry"/></mxCell><mxCell id="n1-5" value="Celular de captura (PWA)&#10;[Sistema · hoy el simulador]&#10;Almacén local sin red,&#10;cola de salida" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="65" width="240" height="100" as="geometry"/></mxCell><mxCell id="n1-6" value="Navegador de la oficina&#10;[Sistema · sin estado propio]&#10;Web del gerente y&#10;del administrador" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="295" width="240" height="100" as="geometry"/></mxCell><mxCell id="n1-7" value="Teléfono del administrador&#10;[Sistema externo · app ntfy]&#10;El administrador recibe ahí&#10;los avisos push del nodo" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="275" width="240" height="100" as="geometry"/></mxCell><mxCell id="n1-8" value="FlorLogic · nodo de finca&#10;[Sistema de software · el producto]&#10;Recibe la jornada, la valida,&#10;la guarda y la muestra.&#10;Opera sin internet, todo&#10;en la red local de la finca" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="240" width="300" height="170" as="geometry"/></mxCell><mxCell id="n1-9" value="FlorLogic · servicios en línea&#10;[Sistema de software · nube]&#10;Custodia de respaldos cifrados,&#10;versiones y soporte remoto.&#10;Nunca en el camino crítico" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="560" width="300" height="120" as="geometry"/></mxCell><mxCell id="n1-10" value="Operador de la plataforma&#10;[Persona · equipo FlorLogic]&#10;Opera sin ver datos&#10;de negocio" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;arcSize=30;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="760" width="300" height="80" as="geometry"/></mxCell><mxCell id="n1-11" value="Almacén de objetos en la nube&#10;[Sistema externo · S3 con&#10;bloqueo de retención]&#10;Respaldos ya cifrados (TX-2)" style="rounded=0;whiteSpace=wrap;html=0;rounded=1;fillColor=#999999;strokeColor=#6b6b6b;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="570" width="240" height="100" as="geometry"/></mxCell><mxCell id="n1-12" value="Captura" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n1-2" target="n1-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-13" value="Entrega la jornada por particiones&#10;[HTTPS, Wi-Fi de la finca · TX-1]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-5" target="n1-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-14" value="Consulta y corrige" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n1-3" target="n1-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-15" value="Administra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-4" target="n1-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-16" value="[HTTPS, red local]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-6" target="n1-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-17" value="Aviso push [HTTPS · CT-3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-8" target="n1-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-18" value="Respaldo cifrado / versiones&#10;[TLS mutuo · TX-2, opcional]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-8" target="n1-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-19" value="Guarda copias inmutables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="n1-9" target="n1-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-20" value="Opera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n1-10" target="n1-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1-21" value="Leyenda&#10;Azul oscuro = persona; azul = FlorLogic;&#10;gris = sistema externo.&#10;Línea gruesa = uso diario en la red local.&#10;Punteada = va por internet y es opcional:&#10;la finca sigue sin ella (ADR-001, ADR-016).&#10;Gateway, WAF, Keycloak, OpenBao y PostgreSQL&#10;son contenedores del nodo: nivel 2 (README §5)." style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1050" y="60" width="290" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
