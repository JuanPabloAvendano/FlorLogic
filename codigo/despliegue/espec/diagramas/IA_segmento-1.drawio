<mxfile host="drawio"><diagram name="1 · Nodo de finca en Compose" id="nodo"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="nodo-1" value="IA_ · Diagramas del Segmento 1 del esqueleto de TX-1 (backend en contenedor + OpenBao)&#10;Quién: IA (Claude), 29-oct-2026, a pedido de Juan · Estado: SIN REVISAR&#10;Manda por encima: ESPEC-esqueleto-tx1.md (A-9…A-43, C-1…C-5) y la palabra de Juan" style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="700" height="60" as="geometry"/></mxCell><mxCell id="nodo-2" value="Anfitrión (fuera de git): variables → Compose secrets (A-10)&#10;FLORLOGIC_PG_ADMIN · FLORLOGIC_HSM_PIN · FLORLOGIC_SOFTHSM_SO_PIN (solo fuera de la finca)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1260" height="70" as="geometry"/></mxCell><mxCell id="nodo-3" value="Red de Docker del nodo · subred FLORLOGIC_RED (A-35) · solo el gateway publica puerto (C-2)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1260" height="560" as="geometry"/></mxCell><mxCell id="nodo-4" value="gateway  (TEC-15, TEC-31)&#10;Nginx + ModSecurity/CRS&#10;resolver ${FLORLOGIC_DNS} valid=10s (A-17, A-18)&#10;proxy_pass http://$backend → backend:8080&#10;publica ${FLORLOGIC_GATEWAY_PUERTO:-80}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="300" height="120" as="geometry"/></mxCell><mxCell id="nodo-5" value="backend  (A-9, A-34)&#10;imagen: Dockerfile multietapa, uid 10001&#10;Spring Cloud Vault 5.0.3 (A-26, A-43)&#10;configtree:/bao/ + vault:// · fail-fast (A-23)&#10;salud: bash /dev/tcp → /actuator/health (A-30)&#10;sin ports:" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="330" height="140" as="geometry"/></mxCell><mxCell id="nodo-6" value="base  (TEC-06)&#10;postgres:16 @digest (COH-42)&#10;POSTGRES_PASSWORD_FILE=/run/secrets/pg-admin&#10;salud: pg_isready · 127.0.0.1:${FLORLOGIC_BASE_PUERTO}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="230" width="300" height="110" as="geometry"/></mxCell><mxCell id="nodo-7" value="openbao  (TEC-33 2.7.2, A-27)&#10;imagen propia · etapa servidor&#10;raft un nodo · node_id finca-1 (A-12)&#10;sello pkcs11 (TEC-35, A-22, A-38)&#10;salud: sys/health?uninitcode=200 (A-28)&#10;restart: unless-stopped · sin ports:" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="440" width="330" height="150" as="geometry"/></mxCell><mxCell id="nodo-8" value='openbao-init  (A-12, A-32, A-36)&#10;imagen propia · etapa init (root)&#10;psql 16 + jq · restart: "no"&#10;1º: init, KV, política, AppRole, secret_id, revoca raíz&#10;siguientes: compara subred (A-41), AppRole,&#10;clave KV = base = anfitrión (A-25)' style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="790" y="420" width="330" height="150" as="geometry"/></mxCell><mxCell id="nodo-9" value="token PKCS#11&#10;finca: token HSM USB (se conecta para abrir)&#10;desarrollo/CI/pruebas: SoftHSM (A-29, A-37)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="300" height="80" as="geometry"/></mxCell><mxCell id="nodo-10" value="Volúmenes con nombre" style="ro