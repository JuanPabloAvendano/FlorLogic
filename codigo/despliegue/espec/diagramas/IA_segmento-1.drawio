etry x="840" y="120" width="240" height="60" as="geometry"/></mxCell><mxCell id="orden-6" value="gateway&#10;arranca solo; 502 mientras&#10;el backend no contesta (A-17)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="240" height="80" as="geometry"/></mxCell><mxCell id="orden-7" value="service_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="orden-2" target="orden-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="orden-8" value="service_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="orden-3" target="orden-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="orden-9" value="service_completed_successfully" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="orden-4" target="orden-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="orden-10" value="Pruebas (pruebas-extremo-a-extremo, se saltan sin Docker)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eef6e8;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="1340" height="250" as="geometry"/></mxCell><mxCell id="orden-11" value="NodoCompletoTest (A-14, A-31) · Segmento 1a&#10;C-1: partición dorada por el gateway → 200 y 2 filas en base&#10;C-2: 18080/8080 del backend y 8200 de OpenBao sin escuchar en el anfitrión" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="640" height="90" as="geometry"/></mxCell><mxCell id="orden-12" value="NodoArranqueSeguroTest (A-33) · Segmento 1b&#10;C-3: segunda corrida de openbao-init no cambia nada&#10;C-4: otra FLORLOGIC_PG_ADMIN → sale ≠0, no reescribe, el backend no escucha&#10;C-5: openbao detenido + restart backend → no escucha&#10;A-29: sin FLORLOGIC_SOFTHSM_CREAR no se crea llave" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="700" y="280" width="640" height="130" as="geometry"/></mxCell><mxCell id="orden-13" value="CanalPorGatewayTest (backend-finca) · Segmento 1a&#10;sigue con todos sus casos del WAF; pasa FLORLOGIC_DNS y una IP en FLORLOGIC_BACKEND (A-18, A-21)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="640" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
