# IA_ · Gateway de la finca (TEC-15) con su WAF (TEC-31): la única puerta de red del nodo de finca (el backend corre
# en Compose sin puerto publicado). Camino mínimo de TX-1.
# Quién: IA (Claude), 20-oct-2026, con visto de Juan; 21-oct-2026: el WAF, a pedido de Jeronimo; 29-oct-2026: el
# backend por nombre, a pedido de Juan; 1-nov-2026: solo HTTPS y mTLS hacia el backend (A-44, A-48), a pedido de Juan
# · Estado: SIN REVISAR
# Manda por encima: despliegue/ESPEC-gateway-finca.md (los A-n y C-n sin prefijo) · despliegue/ESPEC-waf-finca.md
# (los que dicen «WAF A-n») · despliegue/espec/ESPEC-esqueleto-tx1.md (los que dicen «esqueleto A-n»)
# Compose y CanalPorGatewayTest lo montan como /etc/nginx/templates/conf.d/default.conf.template, y la imagen del WAF
# lo convierte en /etc/nginx/conf.d/default.conf al arrancar: así pisa su servidor de ejemplo y deja vivas sus otras
# plantillas (WAF A-8). La imagen sustituye todas las variables de su entorno: aquí solo se usan ${FLORLOGIC_…}, en
# mayúscula; las de Nginx, como $request_id, van en minúscula y no chocan.

# La traza que viaja en cada error, hacia el backend y en el registro: el trace-id del traceparent si viene bien
# formado (W3C), y si no, un id al azar de Nginx (A-11).
map $http_traceparent $traza {
    "~^00-(?<trace_id>[0-9a-f]{32})-[0-9a-f]{16}-[0-9a-f]{2}$" $trace_id;
    default                                                     $request_id;
}

# Allow solo en el 405; una cabecera vacía no se envía (A-5). $request_uri y no $uri: en la página de error, $uri ya es
# la de /_gateway/rechazado. /auth/ y /web admiten GET y POST (CT-2, F4).
map "$status $request_uri" $permitido {
    "~^405 /auth/" "GET, POST";
    "~^405 /web"   "GET, POST";
    "~^405 "       POST;
    default        "";
}

# Nunca Authorization ni el cuerpo (A-11).
log_format gateway '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                   'traza=$traza backend=$upstream_status t=$upstream_response_time';

# Hacia el backend y Keycloak, siempre TLS verificado contra la raíz de la finca (A-44, A-48). El nombre que se
# verifica es el del servicio, no la dirección de FLORLOGIC_BACKEND: así sirve igual por nombre en Compose que por IP
# en CanalPorGatewayTest (COH-47). La intermedia está entre la hoja y la raíz: profundidad 2 (COH-48). El gateway
# presenta su propio certificado al backend, que solo deja entrar a quien lo traiga (mTLS, A-48).
proxy_ssl_trusted_certificate /tls/raiz.crt;
proxy_ssl_verify              on;
proxy_ssl_verify_depth        2;
proxy_ssl_server_name         on;
proxy_ssl_session_reuse       on;   # el apretón de manos se reusa entre particiones (COH-54)

server {
    # Solo HTTPS, sin puerto en claro ni para redirigir (A-44, A-51). La imagen del WAF corre sin privilegios: 8443,
    # y Compose lo publica en el 443 (WAF A-8). El certificado lo emite openbao-init con los nombres de la finca (A-50).
    listen 8443 ssl;
    ssl_certificate     /tls/servidor.crt;
    ssl_certificate_key /tls/servidor.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    server_tokens off;                  # sin versión en Server ni en errores (A-7)

    # El backend se busca por petición, no al arrancar: el gateway arranca sin el backend y responde 502 mientras no
    # contesta (esqueleto A-17). El resolver pregunta solo al DNS, no lee /etc/hosts: en Compose, el de Docker
    # (127.0.0.11); CanalPorGatewayTest da el backend por IP y no pregunta (esqueleto A-18). valid=10s: la IP de un
    # backend recreado se olvida pronto; resolver_timeout 2s: menos que los 30 s del celular (COH-5).
    resolver ${FLORLOGIC_DNS} valid=10s ipv6=off;
    resolver_timeout 2s;
    # El nginx.conf de la imagen trae 10 s; se conservan los 60 s del gateway (§3 del gateway, WAF A-8).
    client_body_timeout 60s;
    access_log /var/log/nginx/access.log gateway;

    # Techo del gateway = max_bytes_particion (§3). Con Content-Length mayor → 413 en cualquier ruta, antes de elegirla;
    # un cuerpo chunked solo se mide al leerlo, en la ruta de ingesta (C-5).
    client_max_body_size 1m;
    client_body_buffer_size 1m;         # la partición entera en memoria, sin archivo temporal (A-10)

    # Todo error que genera Nginx sale en problem+json (A-3, A-9): lo que el cliente pidió mal va a rechazado (4xx,
    # 501 Transfer-Encoding desconocido, 505 versión HTTP) y lo que falla del lado del nodo, a no-disponible. Sin "=" se
    # conserva el código original. Van a ubicaciones internas por URI y no con nombre: con una ubicación con nombre,
    # una línea de petición ilegible o demasiado larga se vuelve 500 en HTML («empty URI in redirect to named
    # location»). El 408 no está: cuando el cuerpo deja de llegar, Nginx corta la conexión sin responder.
    # El 403 es del WAF: lo que parece ataque va a bloqueado (WAF A-3).
    error_page 400 404 405 413 414 501 505 /_gateway/rechazado;
    error_page 494 =400                    /_gateway/rechazado;
    error_page 403                         /_gateway/bloqueado;
    error_page 500 502 503 504             /_gateway/no-disponible;

    # El WAF revisa todo lo que entra por este servidor: la imagen pone «modsecurity on» en http (WAF A-10), y estas
    # reglas se suman a su base y a OWASP CRS 4. Su registro lleva la traza del gateway, para encontrar un bloqueo por
    # el traceId que vio el celular (WAF A-6).
    modsecurity_transaction_id "$traza";
    modsecurity_rules '
        # Bloquea (On) o solo anota (DetectionOnly), según Compose (WAF A-2).
        SecRuleEngine ${FLORLOGIC_WAF_MODO}

        # Revisa lo que entra, nunca las respuestas: si una regla de salida saltara, el dato ya estaría guardado y el
        # celular recibiría un error de algo que sí entró (WAF A-9).
        SecResponseBodyAccess Off
        SecRuleRemoveById 950000-959999

        # El cuerpo entero, hasta el MiB del gateway: la imagen deja de revisarlo pasados 128 KiB (WAF A-5).
        SecRequestBodyNoFilesLimit 1048576

        # Pasado su tope de campos ModSecurity deja de leer, y el resto entraría sin revisar. El tope queda por encima
        # de una partición de 200 anotaciones (unos 3.400 campos), y el 413 hace que el celular la parta (WAF A-5).
        SecArgumentsLimit 10000
        SecRuleRemoveById 200007
        SecRule &ARGS "@ge 10000" "id:10001,phase:2,t:none,log,deny,status:413,msg:Demasiados_campos"

        # La forma del JSON la juzga el backend con su 422. Lo que el WAF no puede leer pasa solo si es UTF-8 simple:
        # el backend sí leería UTF-16, UTF-32 o un BOM que el WAF no revisó (WAF A-4, A-14). validateUtf8Encoding
        # coincide cuando el texto NO es UTF-8 válido.
        SecRuleRemoveById 200002
        SecRule REQBODY_ERROR "!@eq 0" "id:10002,phase:2,t:none,log,deny,status:400,msg:Cuerpo_ilegible_no_UTF8,chain"
            SecRule REQUEST_BODY "@rx (?:^\xef\xbb\xbf|\x00)" "t:none"
        SecRule REQBODY_ERROR "!@eq 0" "id:10003,phase:2,t:none,log,deny,status:400,msg:Cuerpo_ilegible_no_UTF8,chain"
            SecRule REQUEST_BODY "@validateUtf8Encoding" "t:none"

        # El celular llama al nodo por su IP en la red de la finca: esta regla saltaría en cada partición (WAF A-11).
        SecRuleRemoveById 920350

        # La credencial la verifica el backend: ninguna regla que revise todas las cabeceras (941110, XSS) la bloquea ni
        # pone un pedazo de ella en el registro (WAF A-15).
        SecRuleUpdateTargetByTag "OWASP_CRS" "!REQUEST_HEADERS:Authorization"
    ';

    # Las únicas rutas que pasan (A-5, CT-1): abrir la sesión, entregar particiones y cerrarla. El {id} no se valida
    # aquí: es regla del backend; [^/;] impide que «..;» (Tomcat quita lo que va tras el ;) se cuele como un segmento.
    # Entre comillas, porque el ; cerraría la directiva.
    location ~ "^/ingesta/v1/sesiones(/[^/;]+/(particiones|cierre))?$" {
        # if con return es el uso de if dentro de location que la documentación de Nginx da por seguro (el resto es
        # el «if is evil»). limit_except respondería 403; el método ajeno es 405 con Allow: POST.
        if ($request_method != POST) {
            return 405;
        }

        # Con una variable en proxy_pass Nginx resuelve el nombre en cada petición, con el resolver de arriba, y pasa la
        # URI tal como llegó. Sin keepalive a propósito: una conexión que Tomcat ya cerró daría 502 a un POST, que no
        # se reintenta (A-10). Sin bloque upstream, max_fails ya no aplica (esqueleto A-17).
        set $backend "${FLORLOGIC_BACKEND}";
        proxy_pass https://$backend;
        proxy_ssl_name backend;
        proxy_ssl_certificate     /tls/servidor.crt;
        proxy_ssl_certificate_key /tls/servidor.key;
        proxy_set_header Host $host;
        # El gateway es el primer salto: la IP que ve él, no lo que el cliente diga en su propio X-Forwarded-For.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $traza;

        # Conectar incluye el apretón de manos TLS con el backend (A-44), y el WAF revisa el cuerpo en el mismo worker
        # de Nginx mientras tanto: una partición de ~7.000 campos lo dejó en 7 s (CanalPorGatewayTest, 1-nov-2026).
        # Juan: 20 s, se espera mucho flujo y una sincronización puede tardar minutos (A-58). 22 s de espera > 20 s de
        # procesar del contrato (§3). Peor caso 2 + 20 + 22 > 30 s del celular: el celular corta y reintenta, y la
        # partición es idempotente (revisar la espera del celular en el contrato, A-58).
        proxy_connect_timeout 20s;
        proxy_send_timeout 22s;
        proxy_read_timeout 22s;

        # Solo prueba la otra dirección si no pudo conectar; nunca reenvía un POST que ya llegó al backend
        # (sin non_idempotent): el reintento es del celular (A-10).
        proxy_next_upstream error timeout;

        # Si el celular corta, el backend igual guarda: el gateway espera su respuesta y la deja en el registro.
        proxy_ignore_client_abort on;
    }

    # IA_ (Claude, 31-oct-2026, CT-2 · SIN REVISAR) · La identidad: Keycloak (TEC-32), solo el realm florlogic (inicio
    # de sesión, token, llaves, cierre) y sus archivos estáticos. El realm master y la consola de administración no
    # pasan: siguen en 404 abajo, y se administran desde el nodo con kcadm. Los errores de Keycloak salen tal cual (sin
    # proxy_intercept_errors): son de OAuth2, no del gateway. El WAF revisa también esto (formularios y token).
    location ~ "^/auth/(realms/florlogic/|resources/)" {
        if ($request_method !~ ^(GET|POST)$) {
            return 405;
        }
        set $identidad "${FLORLOGIC_IDENTIDAD}";
        proxy_pass https://$identidad;
        proxy_ssl_name keycloak;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $traza;
        proxy_connect_timeout 5s;           # con el apretón de manos TLS (A-44)
        proxy_send_timeout 22s;
        proxy_read_timeout 22s;
        # Keycloak manda cabeceras grandes (cookies de la sesión de inicio): los 4 KiB de Nginx darían 502.
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }

    # IA_ (Claude, 1-nov-2026, F4 · SIN REVISAR) · La web del gerente y del administrador (TEC-24, CT-13): páginas,
    # formularios y htmx, con la sesión en una cookie. El backend decide quién entra (WebDelNodo): sin sesión manda a
    # Keycloak. Host con el puerto ($http_host): la redirect_uri que arma el backend tiene que ser la que el navegador
    # usó. Errores del backend tal cual: son páginas, no problemas del gateway.
    location ~ "^/web(/|$)" {
        if ($request_method !~ ^(GET|POST)$) {
            return 405;
        }
        set $backend "${FLORLOGIC_BACKEND}";
        proxy_pass https://$backend;
        proxy_ssl_name backend;
        proxy_ssl_certificate     /tls/servidor.crt;
        proxy_ssl_certificate_key /tls/servidor.key;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $traza;
        proxy_connect_timeout 5s;           # con el apretón de manos TLS (A-44)
        proxy_send_timeout 22s;
        proxy_read_timeout 22s;
    }

    # Toda otra ruta, también /actuator, se queda aquí (A-5, C-3).
    location / {
        return 404;
    }

    # Las tres ubicaciones de error llevan el WAF apagado: revisa lo que entra, no las respuestas que genera el gateway.
    # Con él encendido, un 400 que Nginx da al leer la línea (/../../etc/passwd) salía como respuesta vacía (WAF A-9).

    # 4xx propios (A-9). types vacío: problem+json aunque la ruta pedida termine en .html. "always": las cabeceras
    # salen también en 4xx y 5xx. El código del cuerpo es el del error, no el del return.
    location = /_gateway/rechazado {
        internal;
        modsecurity off;
        types { }
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        add_header Allow $permitido always;
        return 200 '{"type":"https://florlogic.co/problemas/gateway/rechazado","title":"El gateway no deja pasar la petición","status":$status,"traceId":"$traza"}';
    }

    # 403 del WAF: la petición parecía un ataque. Sin detail ni la regla que saltó: eso queda en su registro, con la
    # misma traza (WAF A-3, A-6).
    location = /_gateway/bloqueado {
        internal;
        modsecurity off;
        types { }
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        return 200 '{"type":"https://florlogic.co/problemas/gateway/bloqueado","title":"El WAF de la finca bloqueó la petición","status":$status,"traceId":"$traza"}';
    }

    # 5xx propios: el backend no contesta (502) o se pasó la espera (504) (A-9).
    location = /_gateway/no-disponible {
        internal;
        modsecurity off;
        types { }
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        return 200 '{"type":"https://florlogic.co/problemas/gateway/no-disponible","title":"El nodo de finca no responde","status":$status,"traceId":"$traza"}';
    }
}

# ── Guía de lectura · IA (Claude), 3-nov-2026, a pedido de Juan · SIN REVISAR ──
# Propósito: el servidor Nginx del gateway, la única puerta de red del nodo: solo HTTPS, deja pasar la ingesta, la
# identidad (Keycloak) y la web; todo lo demás es 404, y todo error propio sale en JSON problem+json.
# Uso: compose.yaml (y la prueba CanalPorGatewayTest) lo montan en /etc/nginx/templates/conf.d/; al arrancar, la
# imagen lo pasa por envsubst (sustituye las variables FLORLOGIC_ del entorno) y lo deja en /etc/nginx/conf.d/.
# Por eso esta guía no escribe ninguna variable de entorno con su signo de pesos y llaves.
# Origen: la cabecera de arriba (ESPEC-gateway-finca, ESPEC-waf-finca y ESPEC-esqueleto-tx1).
# Línea por línea (lo no obvio):
# - map entrada salida { patrón valor; default valor; }: calcula una variable nueva a partir de otra en cada petición.
#   «~» marca expresión regular; (?<trace_id>…) captura un grupo con nombre que se usa como valor.
# - http_traceparent: la cabecera W3C traceparent (versión-trace-id-span-id-banderas) que puede mandar el celular.
# - request_id: identificador al azar de 32 caracteres hexadecimales que Nginx da a cada petición.
# - map "status request_uri" permitido: arma el valor de la cabecera Allow solo para el 405, según la ruta.
# - log_format gateway: formato del registro de acceso; upstream_status y upstream_response_time son el código y el
#   tiempo del backend. Sin cabeceras ni cuerpo.
# - proxy_ssl_trusted_certificate / proxy_ssl_verify on / proxy_ssl_verify_depth 2: al hablar con el backend o
#   Keycloak por HTTPS, Nginx verifica su certificado contra la raíz de la finca, con hasta 2 niveles (hoja,
#   intermedia, raíz). proxy_ssl_server_name on: manda SNI (el nombre del servidor en el saludo TLS).
#   proxy_ssl_session_reuse on: reutiliza la sesión TLS y se ahorra el saludo completo.
# - listen 8443 ssl: escucha HTTPS en 8443 (sin privilegios, Compose lo publica en 443). ssl_certificate y
#   ssl_certificate_key: la cadena y la llave que deja openbao-init. ssl_protocols: solo TLS 1.2 y 1.3.
# - server_tokens off: quita la versión de Nginx de la cabecera Server y de las páginas de error.
# - resolver … valid=10s ipv6=off: el DNS que se usa para resolver el backend en cada petición; recuerda la respuesta
#   10 s y no pide direcciones IPv6. resolver_timeout 2s: espera máxima del DNS.
# - client_body_timeout 60s: tiempo máximo entre dos lecturas del cuerpo.
# - client_max_body_size 1m: cuerpo más grande que 1 MiB es 413. client_body_buffer_size 1m: lo guarda en memoria.
# - error_page códigos URI: si Nginx produce ese código, sirve esa URI interna en su lugar; «=400» cambia el código
#   (494 es el interno de Nginx para cabeceras demasiado grandes).
# - modsecurity_transaction_id "traza": el registro del WAF usa la misma traza que el gateway.
# - modsecurity_rules '…': reglas ModSecurity escritas en línea. SecRuleEngine On o DetectionOnly (lo da Compose con
#   FLORLOGIC_WAF_MODO). SecResponseBodyAccess Off: no lee respuestas. SecRuleRemoveById: apaga reglas de CRS por su
#   número (950000-959999 son las de salida; 200007 y 200002 son reglas base que se reemplazan por 10001-10003).
#   SecRequestBodyNoFilesLimit: tamaño máximo del cuerpo sin archivos que revisa. SecArgumentsLimit: cuántos campos lee.
#   SecRule VARIABLE "operador" "acciones": &ARGS cuenta los campos; @ge mayor o igual; phase:2 se evalúa con el
#   cuerpo ya leído; t:none sin transformaciones; deny,status:413 rechaza con ese código; chain encadena la regla
#   siguiente (las dos tienen que cumplirse). REQBODY_ERROR distinto de 0: el WAF no pudo leer el cuerpo. @rx busca un
#   BOM UTF-8 o un byte nulo. @validateUtf8Encoding: el texto no es UTF-8 válido.
#   SecRuleUpdateTargetByTag "OWASP_CRS" "!REQUEST_HEADERS:Authorization": ninguna regla de CRS mira esa cabecera.
# - location ~ "regex": ruta por expresión regular; entre comillas porque lleva «;». location = /ruta: coincidencia
#   exacta. location /: todo lo que no coincidió con otra.
# - if (request_method != POST) { return 405; }: el único uso de if dentro de location que Nginx garantiza seguro.
# - set backend "…" + proxy_pass https://backend: con una variable, Nginx resuelve el nombre en cada petición (y no
#   falla al arrancar si el backend no existe todavía).
# - proxy_ssl_name backend: nombre que se exige en el certificado del otro lado. proxy_ssl_certificate y
#   proxy_ssl_certificate_key: el certificado que el gateway presenta al backend (mTLS, TLS con certificado de ambos
#   lados). Hacia Keycloak no se presenta.
# - proxy_set_header Host, X-Forwarded-For, X-Forwarded-Proto, X-Forwarded-Host, X-Request-Id: cabeceras para que
#   el backend sepa el nombre que usó el cliente, su IP real, que llegó por https y la traza. http_host incluye el
#   puerto; host no.
# - proxy_connect_timeout / proxy_send_timeout / proxy_read_timeout: esperas para conectar, enviar y leer del backend.
# - proxy_next_upstream error timeout: solo reintenta en otra dirección si no logró conectar; nunca reenvía un POST.
# - proxy_ignore_client_abort on: si el celular corta, Nginx no corta al backend.
# - proxy_buffer_size 16k / proxy_buffers 8 16k: memoria para las cabeceras y la respuesta de Keycloak.
# - internal: la ubicación solo se alcanza por error_page, nunca desde fuera.
# - modsecurity off: el WAF no revisa estas respuestas propias.
# - types { } + default_type application/problem+json: borra el tipo por extensión y fuerza el de problem+json.
# - add_header … always: agrega la cabecera también en respuestas 4xx y 5xx (sin always, solo en 2xx y 3xx).
#   Cache-Control "no-store": que nadie guarde el error en caché.
# - return 200 '…status…': el cuerpo JSON; el código real que recibe el cliente es el del error original, porque
#   error_page sin «=» lo conserva.
