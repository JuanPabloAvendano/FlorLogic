<mxfile host="drawio"><diagram name="1 · Contexto: por dónde pasa una partición" id="ctx"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctx-1" value="IA_ · Diagramas del Segmento 1 del WAF de la finca (TX-1, recibir la información)&#10;Quién: IA (Claude), 21-oct-2026, a pedido de Jeronimo, con visto de Juan · Estado: SIN REVISAR&#10;Manda por encima: despliegue/ESPEC-waf-finca.md (§2, §4, §5, §8) · despliegue/ESPEC-gateway-finca.md" style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="760" height="60" as="geometry"/></mxCell><mxCell id="ctx-2" value="simulador (el celular)&#10;sincronizar --url http://&lt;nodo&gt;:80&#10;(java.net.http; cruza en HTTP/1.1)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="230" height="80" as="geometry"/></mxCell><mxCell id="ctx-3" value="contenedor gateway · owasp/modsecurity-crs:4.30.0-nginx-alpine-202610180210 (TEC-31)&#10;Nginx 1.30.6 (TEC-15) · escucha en el 8080 · Compose publica ${FLORLOGIC_GATEWAY_PUERTO:-80}:8080" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="680" height="420" as="geometry"/></mxCell><mxCell id="ctx-4" value="WAF de la finca (mismo proceso de Nginx)&#10;ModSecurity v3 + OWASP CRS 4.30.0&#10;paranoia 1 · umbral 5&#10;modo ${FLORLOGIC_WAF_MODO} (On, A-2)&#10;revisa ruta, cabeceras (salvo&#10;Authorization) y cuerpo" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="320" y="165" width="300" height="130" as="geometry"/></mxCell><mxCell id="ctx-5" value="location de ingesta&#10;solo POST · proxy_pass&#10;(gateway A-5, A-6)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="180" width="200" height="100" as="geometry"/></mxCell><mxCell id="ctx-6" value="ubicaciones internas · modsecurity off (A-9)&#10;/_gateway/bloqueado  → 403 (parece ataque, A-3)&#10;/_gateway/rechazado → 400 no UTF-8 simple (A-14) · 413 &gt; 10.000 campos (A-5)&#10;                      y los 4xx propios de antes (404, 405, 413 &gt; 1 MiB, 414)&#10;/_gateway/no-disponible → 502, 504" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="640" height="100" as="geometry"/></mxCell><mxCell id="ctx-7" value="registro del WAF · stdout, JSON · partes AHZ (A-6)&#10;fecha, IP, traza (= unique_id), regla y fragmento · nunca cabeceras, cuerpos ni Authorization" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="320" y="440" width="640" height="60" as="geometry"/></mxCell><mxCell id="ctx-8" value="backend-finca (anfitrión, 18080)&#10;ControladorParticiones&#10;200 · 422 ingesta/rechazado" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="180" width="240" height="90" as="geometry"/></mxCell><mxCell id="ctx-9" value="PostgreSQL 16&#10;anotacion_recibida" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="240" height="60" as="geometry"/></mxCell><mxCell id="ctx-10" value="POST partición" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-2" target="ctx-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx-11" value="limpia:&#10;sin cambios" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="ctx-4" target="ctx-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx-12" value="detiene" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-4" target="ctx-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx-13" value="HTTP interno" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="ctx-5" target="ctx-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx-14" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="ctx-8" target="ctx-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx-15" value="anota" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-4" target="ctx-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctx-16" value="Camino mínimo (ESPEC, «Camino mínimo funcional»):&#10;1 el simulador manda la partición al gateway · 2 el WAF la revisa&#10;3 limpia y revisada entera → backend → 200 o su 422, como hoy;&#10;  si no la puede revisar entera → 400 (no UTF-8 simple) o 413 (demasiados campos)&#10;4 parece ataque → 403 gateway/bloqueado · 5 el registro lleva la regla y la traza&#10;Lo que el gateway ya rechaza por ruta, método, tamaño o línea sale antes que el WAF (A-10)." style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="760" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Configuración: qué archivo pone qué" id="cfg"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cfg-1" value="IA_ · Diagramas del Segmento 1 del WAF de la finca (TX-1, recibir la información)&#10;Quién: IA (Claude), 21-oct-2026, a pedido de Jeronimo, con visto de Juan · Estado: SIN REVISAR&#10;Manda por encima: despliegue/ESPEC-waf-finca.md (§2, §4, §5, §8) · despliegue/ESPEC-gateway-finca.md" style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="760" height="60" as="geometry"/></mxCell><mxCell id="cfg-2" value="repo · codigo/despliegue/" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eef6e8;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="680" height="820" as="geometry"/></mxCell><mxCell id="cfg-3" value="gateway/default.conf.template  (cambia)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;collapsible=0;marginBottom=0;html=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="640" height="410" as="geometry"/></mxCell><mxCell id="cfg-4" value="upstream backend · map $traza · map $permitido · log_format" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;html=0;fontFamily=Courier New;fontSize=11;" vertex="1" parent="cfg-3"><mxGeometry y="30" width="640" height="20" as="geomet