;whiteSpace=wrap;html=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="175" width="380" height="70" as="geometry"/></mxCell><mxCell id="mod-7" value="servicios: caso de uso de ingreso&#10;(recibe un comando propio, no el DTO)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="270" width="380" height="55" as="geometry"/></mxCell><mxCell id="mod-8" value="dominio: Anotacion, reglas&#10;Java puro · NO importa contrato (A-44)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="350" width="380" height="55" as="geometry"/></mxCell><mxCell id="mod-9" value="contrato.jar&#10;Published Language: la forma del cable&#10;dto · codigos · lectura · Cabeceras&#10;(sin Spring, sin base de datos)&#10;lo usan los dos lados por Maven" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="330" height="90" as="geometry"/></mxCell><mxCell id="mod-10" value="HTTP · JSON&#10;POST /ingesta/v1/sesiones/{id}/particiones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mod-4" target="mod-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mod-11" value="mapea DTO → comando" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="mod-6" target="mod-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mod-12" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="mod-7" target="mod-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mod-13" value="depende de" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mod-4" target="mod-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mod-14" value="depende de" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mod-5" target="mod-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mod-15" value="Por qué aparte:&#10;• Lo usan DOS programas que se despliegan por separado: el celular y el nodo de finca.&#10;• Si viviera dentro de backend-finca, el simulador tendría que depender de todo el backend&#10;  (Spring, base de datos) o copiar las clases; una copia se desincroniza y el cable se rompe.&#10;• Así, un cambio de forma rompe la compilación de los dos lados a la vez, no en producción.&#10;• El dominio no lo ve: el controlador traduce el DTO a un comando propio (frontera hexagonal).&#10;Fuentes: PoEAA secc. 100 (las clases del DTO «present on both sides»);&#10;DDD Reference p. 43 (Published Language)." style="rounded=0;whiteSpace=wrap;html=0;shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="680" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Segmento 1 · clases" id="s1"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1-1" value="IA_ · Diagramas del Segmento 1 del contrato de ingesta (TX-1.K)&#10;Quién: IA (Claude), 19-oct-2026, a pedido de Juan · Estado: SIN REVISAR&#10;Manda por encima: ESPEC-contrato-ingesta.md