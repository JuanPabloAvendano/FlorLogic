<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>co.florlogic</groupId>
    <artifactId>florlogic</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>simulador</artifactId>
  <name>FlorLogic · simulador del celular</name>

  <dependencies>
    <!-- Corre sobre Spring Boot sin servidor web; picocli sigue siendo la línea de órdenes (TEC-25) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>co.florlogic</groupId>
      <artifactId>contrato</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

<!--
  ── Guía de lectura · IA (Claude), 3-nov-2026, a pedido de Juan · SIN REVISAR ──
  Propósito: el pom del simulador del celular (TEC-25): un programa de línea de órdenes que hace de celular de
  TX-1 y entrega particiones al nodo de finca por el gateway.
  Uso: Maven lo construye dentro de «./mvnw verify»; el .jar ejecutable se corre con «java -jar … sincronizar
  —archivo …» (la opción lleva dos guiones).
  Origen: TEC-25 y la anotación A-6 de .claude/contexto/IA_TECNOLOGIAS-vigentes.md (corre sobre Spring Boot sin
  servidor web; picocli sigue siendo la línea de órdenes).
  Línea por línea (lo no obvio):
  - parent co.florlogic:florlogic: hereda versiones, Java 27 y JaCoCo; ninguna dependencia escribe versión.
  - spring-boot-starter: el núcleo de Spring Boot sin servidor web (inyección, configuración, registro).
  - contrato: los mismos records que lee el nodo; el simulador es el otro lado del contrato.
  - picocli (TEC-25): interpreta las órdenes y opciones (sincronizar, la url, el archivo…).
  - sqlite-jdbc (TEC-25): el controlador de SQLite, previsto para el almacén de salida del celular.
  - spring-boot-starter-test con scope test (TEC-26): JUnit, AssertJ y Mockito.
  - spring-boot-maven-plugin: reempaqueta el .jar como ejecutable («java -jar») con todas sus dependencias.
-->
