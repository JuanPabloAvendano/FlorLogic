<mxfile><diagram name="Modelo de dominio de ingesta (2-nov-2026)"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="Modelo de dominio de ingesta (backend-finca · co.florlogic.finca.ingesta.dominio) · 2-nov-2026" style="text;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="24" as="geometry"/></mxCell><mxCell id="psesion" value="paquete sesion" style="rounded=1;arcSize=2;dashed=1;fillColor=#f8f9fa;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="560" height="470" as="geometry"/></mxCell><mxCell id="Sesion" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«raíz de agregado»&lt;/i&gt;&lt;br&gt;&lt;b&gt;SesionDeSincronizacion&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- id : SesionId&lt;br&gt;- dispositivo : DispositivoId&lt;br&gt;- persona : String&lt;br&gt;- abiertaEn : Instant&lt;br&gt;- desfaseMs : long&lt;br&gt;- versionConfig : int&lt;br&gt;- estado : EstadoSesion&lt;br&gt;- cerradaEn : Instant (nulo si ABIERTA)&lt;hr&gt;+ abrir(id, dispositivo, persona, ahora, relojDelCelular, versionConfig) «fábrica»&lt;br&gt;+ desde(…) : Optional «carga sin lanzar»&lt;br&gt;+ abierta() : boolean&lt;br&gt;+ esDe(persona) : boolean&lt;br&gt;+ cerrar(completa, ahora) → CERRADA o PARCIAL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="330" height="300" as="geometry"/></mxCell><mxCell id="Estado" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«enum»&lt;/i&gt;&lt;br&gt;&lt;b&gt;EstadoSesion&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;ABIERTA&lt;br&gt;CERRADA&lt;br&gt;PARCIAL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">