<mxfile><diagram name="Mapa de órdenes sobre el nodo"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="red" value="red del nodo · FLORLOGIC_RED (docker network inspect)" style="rounded=0;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="40" width="760" height="420" as="geometry"/></mxCell><mxCell id="cel" value="Celular / simulador / curl&lt;br&gt;java -jar simulador/…jar sincronizar&lt;br&gt;curl --cacert $FLORLOGIC_PKI/raiz.crt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="200" height="110" as="geometry"/></mxCell><mxCell id="gw" value="gateway (Nginx + WAF)&lt;br&gt;puerto 443 → 8443&lt;br&gt;DC logs gateway · WAF: FLORLOGIC_WAF_MODO=… DC up -d gateway&lt;br&gt;plantilla cambiada: DC up -d --force-recreate --no-deps gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="190" width="200" height="130" as="geometry"/></mxCell><mxCell id="be" value="backend (Spring Boot)&lt;br&gt;8443 mTLS · 8081 salud&lt;br&gt;DC up -d --build --no-deps --wait backend&lt;br&gt;DC logs -f backend · sin puertos publicados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="200" height="130" as="geometry"/></mxCell><mxCell id="db" value="base (PostgreSQL 16)&lt;br&gt;127.0.0.1:5432&lt;br&gt;DC exec base psql -U florlogic -d florlogic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="180" height="110" as="geometry"/></mxCell><mxCell id="bao" value="openbao (vault + SoftHSM)&lt;br&gt;DC exec openbao bao status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="180" height="110" as="geometry"/></mxCell><mxCell id="ini" value="openbao-init (una vez)&lt;br&gt;DC logs openbao-init&lt;br&gt;sale 0 = listo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="200" height="90" as="geometry"/></mxCell><mxCell id="pki" value="Ceremonia (fuera del nodo)&lt;br&gt;java despliegue/pki/Ceremonia.java raiz | firmar &lt;custodia&gt; &lt;pki&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="200" height="120" as="geometry"/></mxCell><mxCell id="f1" value="HTTPS" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="cel" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="mTLS" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="gw" target="be"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="JDBC" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="be" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="AppRole" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="be" target="bao"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="configura" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="ini" target="bao"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="raiz.crt / intermedia" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="pki" target="ini"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n2" value="DC = docker compose -f despliegue/compose.yaml (desde codigo/) · todo: DC up -d --build --wait · DC ps -a (incluye los parados) · DC down (conserva datos) · DC down -v (borra) · pruebas: env -u FLORLOGIC_CA_RAIZ ./mvnw verify · canal: scripts/IA_probar-canal.sh" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>