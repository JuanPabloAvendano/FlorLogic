<?xml version='1.0' encoding='UTF-8'?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="PRUEBA - property" id="id-prueba-property" version="5.0.0">
  <purpose>Archivo de prueba de 10 segundos. Si abre sin errores, las propiedades escritas a mano funcionan y el modelo C4 puede usar Label Expressions.</purpose>
  <folder name="Application" id="f-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Elemento de prueba" id="e-1">
      <documentation>Si ves este elemento con una propiedad Stereotype = Container en la pestaña Properties, la prueba pasó.</documentation>
      <property key="Stereotype" value="Container"/>
      <property key="Tecnologia" value="PostgreSQL (propuesta)"/>
    </element>
  </folder>
</archimate:model>
