        </object>
        <object placeholders="1" c4Name="Servicio de API Gateway" c4Type="Component" c4Technology="NGINX · proxy inverso y limit_req" c4Description="Recibe solo las peticiones que el WAF dejó pasar. Las enruta al backend según la ruta, limita la tasa por cliente y sirve la aplicación web. El backend nunca queda expuesto a la red." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3gw-k-api">
