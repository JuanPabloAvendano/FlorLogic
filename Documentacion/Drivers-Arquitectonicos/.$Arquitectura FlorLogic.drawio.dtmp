        <object placeholders="1" c4Name="Base de datos de la empresa" c4Type="Container" c4Technology="PostgreSQL (propuesta)" c4Description="Una base independiente por empresa, con esquema común (DEC-11, CN-16). Guarda producción, configuración versionada, bitácora e histórico." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4dep-c-db">
