          </mxCell>
        </object>
        <object placeholders="1" c4Name="Ingreso de sincronización" c4Type="Component" c4Technology="Servicio del backend" c4Description="Recibe sesiones, descarta duplicados y aplica «gana el más reciente» con la hora corregida por el desfase medido del dispositivo, no con la del teléfono (ADR-031). Sin mediación humana (RF-022). Un obligatorio incompleto no frena la entrada: queda como trabajo del gerente de producción." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-ing">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="150" width="240" x="-2022" y="653" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Motor de reglas · instancia servidor" c4Type="Component" c4Technology="Mismo artefacto que en el dispositivo" c4Description="Valida del lado del servidor con la misma versión de reglas (ESC-57)." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-reg">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="135" width="240" x="-1671" y="852" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Motor de proyección" c4Type="Component" c4Technology="Cálculo en el backend" c4Description="Calcula tallos proyectados por sección y publica versiones inmutables con su snapshot de parámetros (RF-006, CN-27). [!] BLOQUEADO por D3: falta de dónde sale el % de productividad y la curva de reparto diario." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-pro">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="195" width="240" x="-1437" y="1941" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Planificador de tareas" c4Type="Component" c4Technology="Cola de trabajos dentro de la misma base (ADR-009)" c4Description="Dispara la publicación de versiones de proyección y el respaldo con su prueba de restauración (ESC-19). El cálculo vivo se rehace con cada sincronización y lo semanal es un piso, no la cadencia (ADR-005, RF-008). [!] Qué dispara una publicación sigue sin decidir." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-job">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="150" width="240" x="-2061" y="1883" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Generador de documentos" c4Type="Component" c4Technology="Apache POI/openpyxl + WeasyPrint/QuestPDF (propuesta)" c4Description="Genera Excel y PDF en 30 segundos o menos (RF-019, ESC-51). Es la única vía de auditoría que se construye (CN-38)." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-doc">
