        <object placeholders="1" c4Name="[Despliegue] Dónde corre cada contenedor" c4Type="DiagramTitle" c4Description="Los cuatro nodos. La nube puede caerse una semana sin parar la finca." label="&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;&lt;div style=&quot;text-align: left&quot;&gt;%c4Name%&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left&quot;&gt;%c4Description%&lt;/div&gt;" id="c4dep-ttl1">
