          </mxCell>
        </object>
        <object placeholders="1" c4Name="Almacén del dispositivo" c4Type="Container" c4Technology="SQLite + SQLCipher (propuesta)" c4Description="Guarda la configuración local vigente (catálogo + reglas + credenciales) y las capturas pendientes, cifradas." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4dep-c-loc">
