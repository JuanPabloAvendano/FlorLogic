        <object placeholders="1" c4Name="N2 · Servidor de la finca" c4Type="Deployment Node" c4Technology="1 por empresa. Es el producto que se compra" c4Description="Oficina, red local. Opera sin internet y además sirve el código de la aplicación web." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4dep-d-n2">
