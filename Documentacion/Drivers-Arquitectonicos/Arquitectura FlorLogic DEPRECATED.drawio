          </mxCell>
        </object>
        <object placeholders="1" c4Name="Emisión de credenciales" c4Type="Component" c4Technology="Firma de token (propuesta)" c4Description="Emite la credencial que el dispositivo verifica sin red y la deposita en el paquete de configuración." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-cre">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="150" width="240" x="-1377" y="960" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Key Vault" c4Type="Component" c4Technology="HashiCorp Vault u OpenBao autoalojado (propuesta)" c4Description="Custodia la llave del cliente. Es lo que permite que la nube guarde respaldos sin poder leerlos (CN-28, B4). El equipo conserva además una copia fuera de línea, en soporte físico, con doble control y registro de cada uso (ADR-012). [!] Descartado el KMS del proveedor de nube: si la llave la administra quien custodia la copia, CN-28 queda vacía." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-kv">
