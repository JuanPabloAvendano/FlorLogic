    <mxGraphModel dx="6428" dy="2082" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="c4n3b-0" />
        <mxCell id="1" parent="c4n3b-0" />
        <object placeholders="1" c4Name="[Nivel 3 · Componentes] Backend de la finca" c4Type="DiagramTitle" c4Description="La autoridad de todo el dato operativo: ingesta, reglas, proyección, consulta y salida. [!] Falta representar el cierre de producción (T6, sin definir) y la generación e impresión de los identificadores de cama." label="&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;&lt;div style=&quot;text-align: left&quot;&gt;%c4Name%&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left&quot;&gt;%c4Description%&lt;/div&gt;" id="c4n3b-ttl1">
