            <mxGeometry height="195" width="240" x="-1293" y="2420" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Servicio de cifrado" c4Type="Component" c4Technology="TLS propio + cifrado de volumen o de base (propuesta)" c4Description="Cifra en tránsito y en reposo, respaldos incluidos (CN-28, CN-03)." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-cif">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="135" width="240" x="-2661" y="2420" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Datos maestros y parametrización versionada" c4Type="Component" c4Technology="Tablas versionadas + paquete firmado" c4Description="Publica el paquete de CT-01 —catálogo, reglas y credenciales— con un solo número de versión, y el snapshot de parámetros de CT-04. [!] La credencial es por persona y por aparato: hay que decidir si el paquete se parte o va personalizado." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-cfg">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="210" width="240" x="-1089" y="1156" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Bitácora de auditoría" c4Type="Component" c4Technology="Tabla append-only con encadenamiento por hash (propuesta)" c4Description="Registra la sesión de captura —quién, cuándo y qué camas— y la sesión de sincronización que la transportó (ADR-035, ADR-028). 0 entradas alterables (ESC-40)." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="c4n3b-k-b-aud">
