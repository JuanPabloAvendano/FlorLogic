<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="FlorLogic - Modelo C4" id="id-florlogic-c4" version="5.0.0">
  <folder name="Strategy" id="id-5a1964b2ae8544f68ab420c9dcdff243" type="strategy"/>
  <folder name="Business" id="f-bus" type="business">
    <element xsi:type="archimate:BusinessActor" name="Supervisor de campo" id="p-sup">
      <documentation>C4: Persona
TECNOLOGÍA: —
RESPONSABILIDAD: Captura siembra, corte, bajas y erradicaciones en el invernadero, sin conexión. Son 3 personas (H-29).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Gerente de producción" id="p-ger">
      <documentation>C4: Persona
TECNOLOGÍA: —
RESPONSABILIDAD: Consume la proyección diaria (H-48). Aprueba las correcciones de registros ya sincronizados (C17).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Personal de ventas" id="p-ven">
      <documentation>C4: Persona
TECNOLOGÍA: —
RESPONSABILIDAD: ~20 personas que solo consultan (H-30). No modifican nada.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Administrador de la empresa" id="p-adm">
      <documentation>C4: Persona
TECNOLOGÍA: —
RESPONSABILIDAD: El ingeniero de sistemas de la finca. Parametriza y ejecuta las correcciones aprobadas (RF-013, RF-017).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Operador de la plataforma" id="p-ope">
      <documentation>C4: Persona
TECNOLOGÍA: —
RESPONSABILIDAD: Equipo FlorLogic. Opera infraestructura; nunca consulta datos de negocio (CN-34, ESC-50).</documentation>
    </element>
  </folder>
  <folder name="Application" id="f-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="FlorLogic" id="s-flor">
      <documentation>C4: Software System
TECNOLOGÍA: Instalación por empresa + servicios en línea (CN-37)
RESPONSABILIDAD: Captura en campo la siembra y el corte por cama, proyecta la producción y mide la desviación entre lo proyectado y lo cortado.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Herramienta de BI del cliente" id="s-bi">
      <documentation>C4: Software System (externo)
TECNOLOGÍA: Power BI (nombrado por el cliente, B5)
RESPONSABILIDAD: Análisis propio del cliente. Consume datos de FlorLogic contra la instalación local (CT-05).
[!] Externo: no lo construye el equipo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sistema heredado de producción" id="s-leg">
      <documentation>C4: Software System (externo)
TECNOLOGÍA: Desconocida — ~300 tablas, 45 de producción (H-39)
RESPONSABILIDAD: Sistema actual de la finca. Nadie lo ha visto todavía.
[!] CN-20 EN DUDA y BLOQUEANTE: sin verlo no se sabe si FlorLogic reemplaza, alimenta o convive.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="App de monitoreo de plagas" id="s-pla">
      <documentation>C4: Software System (externo)
TECNOLOGÍA: App local en celular que sube a la nube (H-34)
RESPONSABILIDAD: Registra plagas y enfermedades. Precedente de offline-first que ya funciona en la finca.
[!] CN-19: no se reemplaza, no se consume, no se integra.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Aplicación de captura" id="c-cap">
      <documentation>C4: Container
TECNOLOGÍA: Android · Flutter o Kotlin nativo (T1 SIN DECIDIR; hoy existe una PWA)
RESPONSABILIDAD: Única entrada de datos del sistema. Valida antes de guardar y funciona toda la jornada sin red (CN-13, CN-22).
[!] T1 la decide A5 (cifrado en reposo demostrable) y CN-21 (qué dispositivo se usa).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Almacén del dispositivo" id="c-loc">
      <documentation>C4: Container · almacén
TECNOLOGÍA: SQLite + SQLCipher (propuesta)
RESPONSABILIDAD: Guarda la configuración local vigente (catálogo + reglas + credenciales) y las capturas pendientes, cifradas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="API Gateway de la finca" id="c-gw">
      <documentation>C4: Container
TECNOLOGÍA: nginx o Caddy (propuesta)
RESPONSABILIDAD: Puerta única de entrada a la instalación. ESC-29 exige 0 accesos directos a la base.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Backend de la finca" id="c-back">
      <documentation>C4: Container
TECNOLOGÍA: Spring Boot · .NET · Node+TypeScript (sin decidir)
RESPONSABILIDAD: Ingesta, reglas de servidor, proyección, consulta, documentos y salida de datos. Autoridad de todo el dato operativo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Base de datos de la empresa" id="c-db">
      <documentation>C4: Container · almacén
TECNOLOGÍA: PostgreSQL (propuesta)
RESPONSABILIDAD: Una base independiente por empresa, con esquema común (DEC-11, CN-16). Guarda producción, configuración versionada, bitácora e histórico.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Aplicación web de consulta" id="c-web">
      <documentation>C4: Container
TECNOLOGÍA: React · Vue · Svelte (propuesta) — se sirve desde el Backend
RESPONSABILIDAD: Proyección, desviación, tableros, vista de camas, administración y exportación. No guarda estado propio.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Servicios en línea" id="c-nube">
      <documentation>C4: Container
TECNOLOGÍA: Contenedores sobre IaaS de precio fijo (propuesta)
RESPONSABILIDAD: Respaldo, distribución de versiones y soporte remoto. Es la mensualidad (E2). Puede caerse una semana sin parar la finca.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Custodia de respaldos" id="c-obj">
      <documentation>C4: Container · almacén
TECNOLOGÍA: MinIO o S3 · Backblaze (propuesta)
RESPONSABILIDAD: Guarda los respaldos que suben las instalaciones. Los recibe ya cifrados con la llave del cliente: no puede leerlos (CN-28).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Interfaz de captura" id="k-cap-ui">
      <documentation>C4: Component
TECNOLOGÍA: Pantallas de la app
RESPONSABILIDAD: Presenta la plantilla activa (novedad de siembra y programa de siembras) y muestra el motivo del rechazo al supervisor (RF-004).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Orquestador local" id="k-cap-orq">
      <documentation>C4: Component
TECNOLOGÍA: Código de dominio de la app
RESPONSABILIDAD: Pide evaluación a las reglas, decide y guarda. Es quien almacena: las reglas solo devuelven veredicto.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Verificación de permisos" id="k-cap-per">
      <documentation>C4: Component
TECNOLOGÍA: Verificación local de token firmado (propuesta)
RESPONSABILIDAD: Aplica los permisos del rol en el dispositivo durante toda la jornada, sin red (RF-014, CN-23).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Motor de reglas · instancia local" id="k-cap-reg">
      <documentation>C4: Component
TECNOLOGÍA: Catálogo JSON + evaluador embebido (reglas.v1.json ya existe)
RESPONSABILIDAD: Evalúa las reglas duras y devuelve el veredicto con el motivo en lenguaje del negocio (CN-22, ESC-56).
[!] CT-02: el MISMO evaluador debe correr en el servidor — ESC-57 pide 0% de divergencia.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Captura de identificador físico" id="k-cap-qr">
      <documentation>C4: Component
TECNOLOGÍA: ML Kit o ZXing (propuesta)
RESPONSABILIDAD: Identifica la cama sin escribirla, en 3 segundos o menos (ESC-27).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicio de cifrado del dispositivo" id="k-cap-cif">
      <documentation>C4: Component
TECNOLOGÍA: Android Keystore + SQLCipher (propuesta)
RESPONSABILIDAD: Cifra en reposo la configuración local y las capturas pendientes.
[!] A5 se decidió EN CONTRA de una respuesta escrita del cliente. Hay que llevarlo a la sesión.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicio de sincronización · cliente" id="k-cap-syn">
      <documentation>C4: Component
TECNOLOGÍA: Contrato propio sobre HTTP, idempotente (ya construido)
RESPONSABILIDAD: Entrega la cola exactamente una vez, reanudable, con ventanas de 15 días o más (RF-003, CT-03).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Ingreso de sincronización" id="k-b-ing">
      <documentation>C4: Component
TECNOLOGÍA: Servicio del backend
RESPONSABILIDAD: Recibe sesiones, descarta duplicados y aplica «gana el más reciente». Sin mediación humana (RF-022, B7).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Motor de reglas · instancia servidor" id="k-b-reg">
      <documentation>C4: Component
TECNOLOGÍA: Mismo artefacto que en el dispositivo
RESPONSABILIDAD: Valida del lado del servidor con la misma versión de reglas (ESC-57).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Motor de proyección" id="k-b-pro">
      <documentation>C4: Component
TECNOLOGÍA: Cálculo en el backend
RESPONSABILIDAD: Calcula tallos proyectados por sección y publica versiones inmutables con su snapshot de parámetros (RF-006, CN-27).
[!] BLOQUEADO por D3: falta de dónde sale el % de productividad y la curva de reparto diario.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Planificador de tareas" id="k-b-job">
      <documentation>C4: Component
TECNOLOGÍA: cron/systemd o Quartz/Hangfire (propuesta)
RESPONSABILIDAD: Dispara la regeneración semanal de la proyección y el respaldo con su prueba de restauración (RF-008, ESC-19).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Consulta y tableros" id="k-b-con">
      <documentation>C4: Component
TECNOLOGÍA: Endpoints propios del backend
RESPONSABILIDAD: Sirve proyectado contra real por día, semana y mes desde el mismo cálculo (RF-018).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Generador de documentos" id="k-b-doc">
      <documentation>C4: Component
TECNOLOGÍA: Apache POI/openpyxl + WeasyPrint/QuestPDF (propuesta)
RESPONSABILIDAD: Genera Excel y PDF en 30 segundos o menos (RF-019, ESC-51). Es la única vía de auditoría que se construye (CN-38).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Interfaz de salida de datos" id="k-b-sal">
      <documentation>C4: Component
TECNOLOGÍA: Endpoint REST o conector OData (propuesta)
RESPONSABILIDAD: Entrega datos a la herramienta de BI del cliente, autenticada y acotada a su empresa. 0 accesos directos a la base (CT-05, ESC-29).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicio de notificación" id="k-b-not">
      <documentation>C4: Component
TECNOLOGÍA: SMTP local + aviso en la app (propuesta)
RESPONSABILIDAD: Avisa a quien capturó cuando su registro fue descartado. Viaja en la siguiente sincronización (RF-022).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Gestión de dispositivos" id="k-b-dis">
      <documentation>C4: Component
TECNOLOGÍA: Capacidad propia de la consola
RESPONSABILIDAD: Ordena sincronizar o actualizar los dispositivos de campo (ESC-25, ESC-46).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Identidad y permisos" id="k-b-iam">
      <documentation>C4: Component
TECNOLOGÍA: Identidad propia del nodo o Keycloak autoalojado (propuesta)
RESPONSABILIDAD: Autoriza cada operación contra el par (rol, empresa) de CN-12.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Emisión de credenciales" id="k-b-cre">
      <documentation>C4: Component
TECNOLOGÍA: Firma de token (propuesta)
RESPONSABILIDAD: Emite la credencial que el dispositivo verifica sin red y la deposita en el paquete de configuración.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Key Vault" id="k-b-kv">
      <documentation>C4: Component
TECNOLOGÍA: HashiCorp Vault u OpenBao autoalojado (propuesta)
RESPONSABILIDAD: Custodia la llave del cliente. Es lo que permite que la nube guarde respaldos sin poder leerlos (CN-28, B4).
[!] Descartado el KMS del proveedor de nube: si la llave la administra quien custodia la copia, CN-28 queda vacía.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicio de cifrado" id="k-b-cif">
      <documentation>C4: Component
TECNOLOGÍA: TLS propio + cifrado de volumen o de base (propuesta)
RESPONSABILIDAD: Cifra en tránsito y en reposo, respaldos incluidos (CN-28, CN-03).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Datos maestros y parametrización versionada" id="k-b-cfg">
      <documentation>C4: Component
TECNOLOGÍA: Tablas versionadas + paquete firmado
RESPONSABILIDAD: Publica el paquete de CT-01 —catálogo, reglas y credenciales— con un solo número de versión, y el snapshot de parámetros de CT-04.
[!] La credencial es por persona y por aparato: hay que decidir si el paquete se parte o va personalizado.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Bitácora de auditoría" id="k-b-aud">
      <documentation>C4: Component
TECNOLOGÍA: Tabla append-only con encadenamiento por hash (propuesta)
RESPONSABILIDAD: Registra por sesión de sincronización quién, desde qué dispositivo y qué entró (RF-016, A1). 0 entradas alterables (ESC-40).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicio de respaldo" id="k-b-bkp">
      <documentation>C4: Component
TECNOLOGÍA: pgBackRest/Barman o Restic/Borg (propuesta)
RESPONSABILIDAD: Respalda, cifra y prueba la restauración. Pérdida CERO y restauración en 1 día o menos (CN-15).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Observabilidad" id="k-b-obs">
      <documentation>C4: Component
TECNOLOGÍA: Registros estructurados + Prometheus/Grafana (propuesta)
RESPONSABILIDAD: Permite identificar la causa en 4 horas o menos sin desplazarse a la finca (ESC-30).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Empaquetado y despliegue" id="k-b-dep">
      <documentation>C4: Component
TECNOLOGÍA: Docker Compose + Flyway/Liquibase (propuesta)
RESPONSABILIDAD: Aplica el mismo paquete que corre en nube y en sitio, y ejecuta las migraciones versionadas (CT-06, CN-29).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Sesión de usuario, roles y permisos" id="k-w-ses">
      <documentation>C4: Component
TECNOLOGÍA: Cookie de sesión firmada (propuesta)
RESPONSABILIDAD: Identifica al usuario y aporta rol y empresa. Sesión corta: en oficina hay red, a diferencia del campo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Tableros de operaciones" id="k-w-tab">
      <documentation>C4: Component
TECNOLOGÍA: ECharts o Chart.js (propuesta)
RESPONSABILIDAD: Qué está sin sincronizar y avance del día por bloque (B12). Instrumentan la medida de Rendimiento de B2.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Vista de camas" id="k-w-cam">
      <documentation>C4: Component
TECNOLOGÍA: SVG generado por el propio código (propuesta)
RESPONSABILIDAD: Vista geométrica con el porcentaje de producción viva por cama (RFP-03, DEC-15). Solo en consulta, nunca en captura (B11).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Vista de proyección y desviación" id="k-w-pro">
      <documentation>C4: Component
TECNOLOGÍA: ECharts o Chart.js (propuesta)
RESPONSABILIDAD: Proyectado contra real por cama, variedad y periodo, señalando lo que sale de la banda (RF-011, RF-018).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Navegación detallada" id="k-w-det">
      <documentation>C4: Component
TECNOLOGÍA: TanStack Table (propuesta)
RESPONSABILIDAD: Descompone cualquier cifra hasta los registros que la forman, en 3 niveles o menos (ESC-39).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Exportación de archivos" id="k-w-exp">
      <documentation>C4: Component
TECNOLOGÍA: Descarga del archivo generado por el servidor
RESPONSABILIDAD: Pide y entrega el Excel o el PDF (RF-019).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Panel de administración" id="k-w-adm">
      <documentation>C4: Component
TECNOLOGÍA: Parte de la aplicación web
RESPONSABILIDAD: Parametrización, usuarios y permisos desde un computador de la finca, sin herramientas técnicas (ESC-14, RF-013).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicios de lectura" id="k-w-lec">
      <documentation>C4: Component
TECNOLOGÍA: fetch + TanStack Query (propuesta)
RESPONSABILIDAD: Único camino de consulta hacia el backend.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicios de escritura" id="k-w-esc">
      <documentation>C4: Component
TECNOLOGÍA: fetch + capa propia
RESPONSABILIDAD: Único camino de modificación hacia el backend. Separarlo de la lectura hace estructural la frontera de RF-017.
[!] ESC-06 y RF-017 se contradicen sobre si el administrador puede modificar producción. Resolver antes de implementar.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Control de borde" id="k-n-bor">
      <documentation>C4: Component
TECNOLOGÍA: TLS mutuo + límite de tasa (propuesta)
RESPONSABILIDAD: Filtra el tráfico antes del gateway. Es máquina a máquina entre N instalaciones conocidas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="API Gateway de la nube" id="k-n-gw">
      <documentation>C4: Component
TECNOLOGÍA: nginx o Caddy (propuesta)
RESPONSABILIDAD: Puerta única de los servicios en línea.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Identity Management" id="k-n-iam">
      <documentation>C4: Component
TECNOLOGÍA: Certificados de cliente por instalación (propuesta)
RESPONSABILIDAD: Identifica INSTALACIONES y OPERADORES, nunca usuarios de una finca (CN-34).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Distribución de versiones" id="k-n-ver">
      <documentation>C4: Component
TECNOLOGÍA: Registro de contenedores + servicio propio (propuesta)
RESPONSABILIDAD: Entrega la versión nueva solo a instalaciones vigentes. Es el mecanismo de «pagas, te actualizas» (E2, CN-29).
[!] Riesgo escrito: la instalación que deja de pagar diverge de versión.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Recepción y entrega de respaldos" id="k-n-res">
      <documentation>C4: Component
TECNOLOGÍA: Servicio propio
RESPONSABILIDAD: Guarda sin poder leer y devuelve el archivo tal cual para restaurar. Descifra la finca, no la nube.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Recepción de telemetría" id="k-n-tel">
      <documentation>C4: Component
TECNOLOGÍA: Servicio propio
RESPONSABILIDAD: Recibe el estado de las instalaciones, sin datos de negocio (CN-34, ESC-50).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Panel de soporte remoto" id="k-n-sop">
      <documentation>C4: Component
TECNOLOGÍA: Interfaz propia sobre el registro de operaciones
RESPONSABILIDAD: Diagnóstico sin desplazarse. Deja constancia de todo acceso excepcional (ESC-50).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Servicio de IA analítica" id="k-n-ia">
      <documentation>C4: Component
TECNOLOGÍA: Ollama + modelo abierto — UBICACIÓN SIN DECIDIR
RESPONSABILIDAD: Consultas y análisis sobre la información de la empresa (RFP-06).
[!] EN CONFLICTO: no puede leer lo que el Key Vault mantiene cifrado, y en la nube haría que la consulta dependa de internet. La decisión 5 lo resuelve si corre en el nodo de la finca.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="Integración y despliegue continuos" id="k-n-cicd">
      <documentation>C4: Component
TECNOLOGÍA: GitHub Actions (propuesta)
RESPONSABILIDAD: Publica el paquete firmado. Infraestructura del equipo: NO es parte de la mensualidad (E2).</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="f-tec" type="technology">
    <element xsi:type="archimate:Node" name="N1 · Dispositivo Android" id="d-n1">
      <documentation>C4: Deployment Node
TECNOLOGÍA: 3 unidades, las pone la empresa (B10)
RESPONSABILIDAD: Invernadero, SIN conectividad (CN-17). Vuelve a la oficina y sincroniza por red local.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="N2 · Servidor de la finca" id="d-n2">
      <documentation>C4: Deployment Node
TECNOLOGÍA: 1 por empresa. Es el producto que se compra (CN-37, CN-02)
RESPONSABILIDAD: Oficina, red local. Opera sin internet y además sirve el código de la aplicación web.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="N3 · Computador de oficina" id="d-n3">
      <documentation>C4: Deployment Node
TECNOLOGÍA: ~12 usuarios + ~20 que solo consultan
RESPONSABILIDAD: Oficina, red local. Ejecuta la aplicación web dentro del navegador. No guarda estado.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="N4 · Infraestructura en la nube" id="d-n4">
      <documentation>C4: Deployment Node
TECNOLOGÍA: IaaS de precio fijo (propuesta)
RESPONSABILIDAD: Internet. Nunca en el camino crítico: puede caerse una semana sin parar la finca.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-4ef052fc6f54403eb86400fc7fdf3437" type="motivation"/>
